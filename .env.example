ENV=development

# choose one between this two
OPENAI_API_KEY=sk-xxxxxxx
ANTHROPIC_API_KEY=

# use openai base url or anthropic base url
AI_BASE_URL=https://xxx.com/api

# use your model
AI_INSTRUCT_MODEL_NAME=gpt-4.1 # non reasoning model
AI_THINK_MODEL_NAME=gpt-4.1 # reasoning model
AI_DEEP_THINK_MODEL_NAME=gpt-4.1 # best reasoning model
AI_EMBEDDINGS_MODEL_NAME=text-embedding-large # embeddings model

POSTGRES_URI=postgresql+asyncpg://username:password@localhost:5452/

# Chatbot Ambiguity Handling Configuration
CHATBOT_AMBIGUITY_ENABLED=true
CHATBOT_AMBIGUITY_DETECTION_MAX_TOKENS=1024
CHATBOT_AMBIGUITY_REFINE_MAX_TOKENS=512
CHATBOT_AMBIGUITY_TEMPERATURE=0.1
CHATBOT_AMBIGUITY_TIMEOUT_SECONDS=10
CHATBOT_AMBIGUITY_RATE_LIMIT_RETRIES=3
CHATBOT_AMBIGUITY_SESSION_TTL_SECONDS=300
CHATBOT_AMBIGUITY_AUTO_RESOLVE_WINDOW=3
CHATBOT_AMBIGUITY_MAX_HISTORY_TURNS=3
